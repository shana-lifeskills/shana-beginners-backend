{
  "openapi": "3.0.0",
  "info": {
    "title": "Shana E-Learning API",
    "version": "2.0.0",
    "description": "API for the SHANA eLearning platform. Use Authorize to set a Bearer token after login."
  },
  "servers": [
    {
      "url": "https://api-shana-beginners.onrender.com",
      "description": "Production"
    },
    {
      "url": "http://localhost:3000",
      "description": "Local"
    }
  ],
  "components": {
    "securitySchemes": {
      "bearerAuth": {
        "type": "http",
        "scheme": "bearer",
        "bearerFormat": "JWT"
      }
    },
    "schemas": {
      "LoginBody": {
        "type": "object",
        "required": [
          "email",
          "password"
        ],
        "properties": {
          "email": {
            "type": "string",
            "format": "email"
          },
          "password": {
            "type": "string"
          }
        }
      },
      "RegisterBody": {
        "type": "object",
        "required": [
          "firstName",
          "lastName",
          "email",
          "password"
        ],
        "properties": {
          "firstName": {
            "type": "string"
          },
          "lastName": {
            "type": "string"
          },
          "email": {
            "type": "string",
            "format": "email"
          },
          "password": {
            "type": "string",
            "description": "At least 8 characters, one letter and one number"
          },
          "profileImage": {
            "type": "string",
            "nullable": true,
            "description": "URL or path (optional)"
          },
          "role": {
            "type": "string",
            "enum": [
              "student"
            ],
            "description": "Optional; only \"student\" is accepted. Admin and Trainer (instructor) accounts are created by an administrator with `npm run staff:create`."
          },
          "ageGroup": {
            "type": "string",
            "enum": [
              "beginner",
              "advanced"
            ],
            "description": "Student level; defaults to beginner"
          },
          "avatarId": {
            "type": "string",
            "enum": [
              "nova",
              "milo",
              "zoe",
              "kai",
              "ruby",
              "theo"
            ],
            "description": "Optional built-in avatar"
          },
          "studentProfile": {
            "type": "object",
            "description": "Child-registration details from the student signup stepper. Only used when role is student.",
            "required": [
              "gender",
              "dateOfBirth",
              "age",
              "school",
              "gradeClass",
              "country",
              "parentGuardianName",
              "parentPhone",
              "parentWhatsapp",
              "enrolProgram",
              "howDidYouHear",
              "growthAreas",
              "desiredSkills",
              "termsAccepted"
            ],
            "properties": {
              "middleName": { "type": "string", "nullable": true },
              "preferredName": { "type": "string", "nullable": true },
              "gender": { "type": "string", "enum": ["male", "female"] },
              "dateOfBirth": { "type": "string", "format": "date" },
              "age": { "type": "integer", "minimum": 3, "maximum": 17 },
              "school": { "type": "string" },
              "gradeClass": { "type": "string" },
              "country": { "type": "string" },
              "parentGuardianName": { "type": "string" },
              "parentPhone": { "type": "string" },
              "parentWhatsapp": { "type": "string" },
              "enrolProgram": {
                "type": "string",
                "enum": ["soft-skills", "tech-skills", "language-skills", "personal-coaching"]
              },
              "howDidYouHear": {
                "type": "array",
                "items": {
                  "type": "string",
                  "enum": ["whatsapp", "instagram", "facebook", "family-friend", "other"]
                }
              },
              "howDidYouHearOther": { "type": "string", "nullable": true, "description": "Required if 'other' is included in howDidYouHear" },
              "growthAreas": { "type": "string" },
              "desiredSkills": { "type": "string" },
              "termsAccepted": { "type": "boolean", "description": "Must be true — registration is rejected otherwise" }
            }
          }
        }
      },
      "StartModuleBody": {
        "type": "object",
        "properties": {
          "resumeLessonId": {
            "type": "string"
          },
          "resumeExerciseId": {
            "type": "string",
            "nullable": true
          }
        }
      },
      "CompleteStepBody": {
        "type": "object",
        "required": [
          "lessonId",
          "lessonCompleted",
          "moduleCompleted"
        ],
        "properties": {
          "lessonId": {
            "type": "string"
          },
          "lessonCompleted": {
            "type": "boolean"
          },
          "moduleCompleted": {
            "type": "boolean"
          },
          "completedExerciseIds": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "completedLessonIds": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "currentLessonId": {
            "type": "string",
            "nullable": true
          },
          "currentExerciseId": {
            "type": "string",
            "nullable": true
          },
          "submissionValues": {
            "type": "object",
            "additionalProperties": {
              "type": "string"
            }
          },
          "studentName": {
            "type": "string"
          }
        }
      },
      "AssignModuleBody": {
        "type": "object",
        "required": [
          "moduleId",
          "studentIds"
        ],
        "properties": {
          "moduleId": {
            "type": "string"
          },
          "studentIds": {
            "type": "array",
            "items": {
              "type": "string"
            }
          }
        }
      },
      "StudentModuleProgress": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string"
          },
          "userId": {
            "type": "string"
          },
          "moduleId": {
            "type": "string"
          },
          "status": {
            "type": "string",
            "enum": [
              "not-started",
              "in-progress",
              "completed"
            ]
          },
          "completedExerciseIds": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "completedLessonIds": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "currentLessonId": {
            "type": "string",
            "nullable": true
          },
          "currentExerciseId": {
            "type": "string",
            "nullable": true
          },
          "startedAt": {
            "type": "string",
            "format": "date-time",
            "nullable": true
          },
          "completedAt": {
            "type": "string",
            "format": "date-time",
            "nullable": true
          }
        }
      },
      "InitializePaymentResponse": {
        "type": "object",
        "properties": {
          "reference": {
            "type": "string"
          },
          "publicKey": {
            "type": "string"
          },
          "amountPesewas": {
            "type": "integer"
          }
        }
      },
      "VerifyPaymentBody": {
        "type": "object",
        "required": [
          "reference"
        ],
        "properties": {
          "reference": {
            "type": "string"
          }
        }
      },
      "InitiateMobileMoneyBody": {
        "type": "object",
        "required": [
          "phone",
          "provider"
        ],
        "properties": {
          "phone": {
            "type": "string",
            "example": "0241234567"
          },
          "provider": {
            "type": "string",
            "enum": [
              "mtn",
              "vod",
              "atl"
            ],
            "description": "mtn=MTN, vod=Telecel, atl=AirtelTigo"
          }
        }
      },
      "InitiateMobileMoneyResponse": {
        "type": "object",
        "properties": {
          "reference": {
            "type": "string"
          },
          "status": {
            "type": "string",
            "enum": [
              "success",
              "send_otp",
              "pay_offline"
            ]
          },
          "displayText": {
            "type": "string"
          },
          "hasPaid": {
            "type": "boolean"
          }
        }
      },
      "SubmitMobileMoneyOtpBody": {
        "type": "object",
        "required": [
          "reference",
          "otp"
        ],
        "properties": {
          "reference": {
            "type": "string"
          },
          "otp": {
            "type": "string"
          }
        }
      }
    }
  },
  "paths": {
    "/api/auth/register": {
      "post": {
        "summary": "Register",
        "tags": [
          "Auth"
        ],
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/RegisterBody"
              }
            }
          }
        },
        "responses": {
          "201": {
            "description": "Created"
          },
          "403": {
            "description": "A staff role (admin or instructor) was requested — staff accounts cannot self-register"
          },
          "409": {
            "description": "Email already in use"
          }
        }
      }
    },
    "/api/auth/login": {
      "post": {
        "summary": "Login",
        "tags": [
          "Auth"
        ],
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/LoginBody"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Returns accessToken and user"
          },
          "401": {
            "description": "Invalid credentials"
          }
        }
      }
    },
    "/api/auth/refresh": {
      "post": {
        "summary": "Refresh token (uses cookie)",
        "tags": [
          "Auth"
        ],
        "responses": {
          "200": {
            "description": "New accessToken"
          },
          "401": {
            "description": "No/invalid refresh token"
          }
        }
      }
    },
    "/api/auth/logout": {
      "post": {
        "summary": "Logout",
        "tags": [
          "Auth"
        ],
        "security": [
          {
            "bearerAuth": []
          }
        ],
        "responses": {
          "200": {
            "description": "Cookie cleared"
          }
        }
      }
    },
    "/api/users/me": {
      "get": {
        "summary": "Get my profile",
        "tags": [
          "Users"
        ],
        "security": [
          {
            "bearerAuth": []
          }
        ],
        "responses": {
          "200": {
            "description": "User profile"
          },
          "401": {
            "description": "Unauthorized"
          }
        }
      },
      "put": {
        "summary": "Update my profile",
        "tags": [
          "Users"
        ],
        "security": [
          {
            "bearerAuth": []
          }
        ],
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "properties": {
                  "firstName": {
                    "type": "string"
                  },
                  "lastName": {
                    "type": "string"
                  },
                  "email": {
                    "type": "string"
                  },
                  "profileImage": {
                    "type": "string",
                    "nullable": true
                  }
                }
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Updated user"
          }
        }
      }
    },
    "/api/students": {
      "get": {
        "summary": "List students (instructor/admin)",
        "tags": [
          "Students"
        ],
        "security": [
          {
            "bearerAuth": []
          }
        ],
        "responses": {
          "200": {
            "description": "List of students"
          }
        }
      }
    },
    "/api/students/{id}": {
      "get": {
        "summary": "Get student by id",
        "tags": [
          "Students"
        ],
        "security": [
          {
            "bearerAuth": []
          }
        ],
        "parameters": [
          {
            "name": "id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "OK"
          },
          "404": {
            "description": "Not found"
          }
        }
      },
      "put": {
        "summary": "Update student",
        "tags": [
          "Students"
        ],
        "security": [
          {
            "bearerAuth": []
          }
        ],
        "parameters": [
          {
            "name": "id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "OK"
          },
          "404": {
            "description": "Not found"
          }
        }
      },
      "delete": {
        "summary": "Delete student (admin)",
        "tags": [
          "Students"
        ],
        "security": [
          {
            "bearerAuth": []
          }
        ],
        "parameters": [
          {
            "name": "id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
          "204": {
            "description": "No content"
          },
          "404": {
            "description": "Not found"
          }
        }
      }
    },
    "/api/progress/{moduleId}/start": {
      "post": {
        "summary": "Start or resume a student's progress in a module",
        "tags": [
          "Progress"
        ],
        "security": [
          {
            "bearerAuth": []
          }
        ],
        "parameters": [
          {
            "name": "moduleId",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string"
            }
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/StartModuleBody"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "OK",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/StudentModuleProgress"
                }
              }
            }
          }
        }
      }
    },
    "/api/progress/{moduleId}/steps/{exerciseId}/complete": {
      "post": {
        "summary": "Record the client-computed outcome of completing one exercise step",
        "tags": [
          "Progress"
        ],
        "security": [
          {
            "bearerAuth": []
          }
        ],
        "parameters": [
          {
            "name": "moduleId",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "exerciseId",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string"
            }
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/CompleteStepBody"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "OK"
          }
        }
      }
    },
    "/api/progress/{moduleId}/stars/{exerciseId}": {
      "post": {
        "summary": "Idempotently award a standalone star for one exercise",
        "tags": [
          "Progress",
          "Gamification"
        ],
        "security": [
          {
            "bearerAuth": []
          }
        ],
        "parameters": [
          {
            "name": "moduleId",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "exerciseId",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "OK"
          }
        }
      }
    },
    "/api/progress": {
      "get": {
        "summary": "List a student's progress across all started modules",
        "tags": [
          "Progress"
        ],
        "security": [
          {
            "bearerAuth": []
          }
        ],
        "parameters": [
          {
            "name": "studentId",
            "in": "query",
            "required": false,
            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "OK",
            "content": {
              "application/json": {
                "schema": {
                  "type": "array",
                  "items": {
                    "$ref": "#/components/schemas/StudentModuleProgress"
                  }
                }
              }
            }
          }
        }
      }
    },
    "/api/progress/{moduleId}": {
      "get": {
        "summary": "Get a student's progress for one module",
        "tags": [
          "Progress"
        ],
        "security": [
          {
            "bearerAuth": []
          }
        ],
        "parameters": [
          {
            "name": "moduleId",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "studentId",
            "in": "query",
            "required": false,
            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "OK",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/StudentModuleProgress"
                }
              }
            }
          }
        }
      }
    },
    "/api/progress/submissions": {
      "get": {
        "summary": "Get all students' submissions for one exercise (a shared discussion board, not scoped to the caller)",
        "tags": [
          "Progress"
        ],
        "security": [
          {
            "bearerAuth": []
          }
        ],
        "parameters": [
          {
            "name": "exerciseId",
            "in": "query",
            "required": true,
            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "OK"
          }
        }
      }
    },
    "/api/progress/rewards/totals": {
      "get": {
        "summary": "Get a student's star/badge/trophy totals",
        "tags": [
          "Gamification"
        ],
        "security": [
          {
            "bearerAuth": []
          }
        ],
        "parameters": [
          {
            "name": "studentId",
            "in": "query",
            "required": false,
            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "OK"
          }
        }
      }
    },
    "/api/progress/rewards/details": {
      "get": {
        "summary": "Get a student's earned badge/trophy history",
        "tags": [
          "Gamification"
        ],
        "security": [
          {
            "bearerAuth": []
          }
        ],
        "parameters": [
          {
            "name": "studentId",
            "in": "query",
            "required": false,
            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "OK"
          }
        }
      }
    },
    "/api/progress/rewards/stars-this-week": {
      "get": {
        "summary": "Get how many stars a student earned in the last 7 days",
        "tags": [
          "Gamification"
        ],
        "security": [
          {
            "bearerAuth": []
          }
        ],
        "parameters": [
          {
            "name": "studentId",
            "in": "query",
            "required": false,
            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "OK"
          }
        }
      }
    },
    "/api/assignments": {
      "post": {
        "summary": "Assign a module to one or more students",
        "tags": [
          "Assignments"
        ],
        "security": [
          {
            "bearerAuth": []
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/AssignModuleBody"
              }
            }
          }
        },
        "responses": {
          "201": {
            "description": "Created"
          }
        }
      }
    },
    "/api/assignments/batch": {
      "get": {
        "summary": "Get assigned module ids for multiple students at once",
        "tags": [
          "Assignments"
        ],
        "security": [
          {
            "bearerAuth": []
          }
        ],
        "parameters": [
          {
            "name": "studentIds",
            "in": "query",
            "required": true,
            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "OK"
          }
        }
      }
    },
    "/api/assignments/{studentId}": {
      "get": {
        "summary": "Get the module ids assigned to one student",
        "tags": [
          "Assignments"
        ],
        "security": [
          {
            "bearerAuth": []
          }
        ],
        "parameters": [
          {
            "name": "studentId",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "OK"
          }
        }
      }
    },
    "/api/payments/initialize": {
      "post": {
        "summary": "Create a pending payment and get a Paystack reference to check out with",
        "tags": [
          "Payments"
        ],
        "security": [
          {
            "bearerAuth": []
          }
        ],
        "responses": {
          "200": {
            "description": "OK",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/InitializePaymentResponse"
                }
              }
            }
          }
        }
      }
    },
    "/api/payments/verify": {
      "post": {
        "summary": "Verify a completed Paystack checkout and, on success, mark the student paid",
        "tags": [
          "Payments"
        ],
        "security": [
          {
            "bearerAuth": []
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/VerifyPaymentBody"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "OK"
          }
        }
      }
    },
    "/api/payments/webhook": {
      "post": {
        "summary": "Paystack server-to-server webhook (signature-verified, not JWT-authenticated)",
        "tags": [
          "Payments"
        ],
        "responses": {
          "200": {
            "description": "Acknowledged"
          },
          "401": {
            "description": "Invalid signature"
          }
        }
      }
    },
    "/api/payments/mobile-money/initiate": {
      "post": {
        "summary": "Start an MTN/Telecel/AirtelTigo mobile money charge",
        "tags": [
          "Payments"
        ],
        "security": [
          {
            "bearerAuth": []
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/InitiateMobileMoneyBody"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "OK",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/InitiateMobileMoneyResponse"
                }
              }
            }
          }
        }
      }
    },
