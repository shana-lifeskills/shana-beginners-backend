{
  "openapi": "3.0.0",
  "info": {
    "title": "Shana E-Learning API",
    "version": "2.0.0",
    "description": "API for the SHANA eLearning platform. Use Authorize to set a Bearer token after login."
  },
  "servers": [
    {
      "url": "https://api-shana-beginners.onrender.com",
      "description": "Production"
    },
    {
      "url": "http://localhost:3000",
      "description": "Local"
    }
  ],
  "components": {
    "securitySchemes": {
      "bearerAuth": {
        "type": "http",
        "scheme": "bearer",
        "bearerFormat": "JWT"
      }
    },
    "schemas": {
      "LoginBody": {
        "type": "object",
        "required": [
          "email",
          "password"
        ],
        "properties": {
          "email": {
            "type": "string",
            "format": "email"
          },
          "password": {
            "type": "string"
          }
        }
      },
      "RegisterBody": {
        "type": "object",
        "required": [
          "firstName",
          "lastName",
          "email",
          "password"
        ],
        "properties": {
          "firstName": {
            "type": "string"
          },
          "lastName": {
            "type": "string"
          },
          "email": {
            "type": "string",
            "format": "email"
          },
          "password": {
            "type": "string",
            "description": "At least 8 characters, one letter and one number"
          },
          "profileImage": {
            "type": "string",
            "nullable": true,
            "description": "URL or path (optional)"
          },
          "role": {
            "type": "string",
            "enum": [
              "student",
              "instructor"
            ],
            "description": "Defaults to student if omitted. admin cannot be self-registered."
          }
        }
      },
      "ModuleBody": {
        "type": "object",
        "properties": {
          "title": {
            "type": "string"
          },
          "description": {
            "type": "string"
          },
          "thumbnail": {
            "type": "string"
          },
          "icon": {
            "type": "string"
          },
          "difficulty": {
            "type": "string",
            "enum": [
              "beginner",
              "intermediate",
              "advanced"
            ]
          },
          "published": {
            "type": "boolean"
          },
          "totalStars": {
            "type": "integer"
          },
          "totalBadges": {
            "type": "integer"
          },
          "totalTrophies": {
            "type": "integer"
          }
        }
      },
      "LessonBody": {
        "type": "object",
        "properties": {
          "title": {
            "type": "string"
          },
          "content": {
            "type": "string"
          },
          "videoUrl": {
            "type": "string"
          },
          "order": {
            "type": "integer"
          },
          "duration": {
            "type": "integer"
          },
          "weekNumber": {
            "type": "integer"
          },
          "totalStars": {
            "type": "integer"
          },
          "totalBadges": {
            "type": "integer"
          },
          "totalTrophies": {
            "type": "integer"
          }
        }
      },
      "LessonProgressBody": {
        "type": "object",
        "required": [
          "progress"
        ],
        "properties": {
          "progress": {
            "type": "integer",
            "minimum": 0,
            "maximum": 100
          },
          "starsEarned": {
            "type": "integer"
          },
          "badgesEarned": {
            "type": "integer"
          },
          "trophiesEarned": {
            "type": "integer"
          }
        }
      },
      "StartModuleBody": {
        "type": "object",
        "properties": {
          "resumeLessonId": {
            "type": "string"
          },
          "resumeExerciseId": {
            "type": "string",
            "nullable": true
          }
        }
      },
      "CompleteStepBody": {
        "type": "object",
        "required": [
          "lessonId",
          "lessonCompleted",
          "moduleCompleted"
        ],
        "properties": {
          "lessonId": {
            "type": "string"
          },
          "lessonCompleted": {
            "type": "boolean"
          },
          "moduleCompleted": {
            "type": "boolean"
          },
          "completedExerciseIds": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "completedLessonIds": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "currentLessonId": {
            "type": "string",
            "nullable": true
          },
          "currentExerciseId": {
            "type": "string",
            "nullable": true
          },
          "submissionValues": {
            "type": "object",
            "additionalProperties": {
              "type": "string"
            }
          },
          "studentName": {
            "type": "string"
          }
        }
      },
      "AssignModuleBody": {
        "type": "object",
        "required": [
          "moduleId",
          "studentIds"
        ],
        "properties": {
          "moduleId": {
            "type": "string"
          },
          "studentIds": {
            "type": "array",
            "items": {
              "type": "string"
            }
          }
        }
      },
      "StudentModuleProgress": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string"
          },
          "userId": {
            "type": "string"
          },
          "moduleId": {
            "type": "string"
          },
          "status": {
            "type": "string",
            "enum": [
              "not-started",
              "in-progress",
              "completed"
            ]
          },
          "completedExerciseIds": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "completedLessonIds": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "currentLessonId": {
            "type": "string",
            "nullable": true
          },
          "currentExerciseId": {
            "type": "string",
            "nullable": true
          },
          "startedAt": {
            "type": "string",
            "format": "date-time",
            "nullable": true
          },
          "completedAt": {
            "type": "string",
            "format": "date-time",
            "nullable": true
          }
        }
      },
      "InitializePaymentResponse": {
        "type": "object",
        "properties": {
          "reference": {
            "type": "string"
          },
          "publicKey": {
            "type": "string"
          },
          "amountPesewas": {
            "type": "integer"
          }
        }
      },
      "VerifyPaymentBody": {
        "type": "object",
        "required": [
          "reference"
        ],
        "properties": {
          "reference": {
            "type": "string"
          }
        }
      },
      "InitiateMobileMoneyBody": {
        "type": "object",
        "required": [
          "phone",
          "provider"
        ],
        "properties": {
          "phone": {
            "type": "string",
            "example": "0241234567"
          },
          "provider": {
            "type": "string",
            "enum": [
              "mtn",
              "vod",
              "atl"
            ],
            "description": "mtn=MTN, vod=Telecel, atl=AirtelTigo"
          }
        }
      },
      "InitiateMobileMoneyResponse": {
        "type": "object",
        "properties": {
          "reference": {
            "type": "string"
          },
          "status": {
            "type": "string",
            "enum": [
              "success",
              "send_otp",
              "pay_offline"
            ]
          },
          "displayText": {
            "type": "string"
          },
          "hasPaid": {
            "type": "boolean"
          }
        }
      },
      "SubmitMobileMoneyOtpBody": {
        "type": "object",
        "required": [
          "reference",
          "otp"
        ],
        "properties": {
          "reference": {
            "type": "string"
          },
          "otp": {
            "type": "string"
          }
        }
      }
    }
  },
  "paths": {
    "/api/auth/register": {
      "post": {
        "summary": "Register",
        "tags": [
          "Auth"
        ],
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/RegisterBody"
              }
            }
          }
        },
        "responses": {
          "201": {
            "description": "Created"
          },
          "409": {
            "description": "Email already in use"
          }
        }
      }
    },
    "/api/auth/login": {
      "post": {
        "summary": "Login",
        "tags": [
          "Auth"
        ],
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/LoginBody"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Returns accessToken and user"
          },
          "401": {
            "description": "Invalid credentials"
          }
        }
      }
    },
    "/api/auth/refresh": {
      "post": {
        "summary": "Refresh token (uses cookie)",
        "tags": [
          "Auth"
        ],
        "responses": {
          "200": {
            "description": "New accessToken"
          },
          "401": {
            "description": "No/invalid refresh token"
          }
        }
      }
    },
    "/api/auth/logout": {
      "post": {
        "summary": "Logout",
        "tags": [
          "Auth"
        ],
        "security": [
          {
            "bearerAuth": []
          }
        ],
        "responses": {
          "200": {
            "description": "Cookie cleared"
          }
        }
      }
    },
    "/api/users/me": {
      "get": {
        "summary": "Get my profile",
        "tags": [
          "Users"
        ],
        "security": [
          {
            "bearerAuth": []
          }
        ],
        "responses": {
          "200": {
            "description": "User profile"
          },
          "401": {
            "description": "Unauthorized"
          }
        }
      },
      "put": {
        "summary": "Update my profile",
        "tags": [
          "Users"
        ],
        "security": [
          {
            "bearerAuth": []
          }
        ],
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "properties": {
                  "firstName": {
                    "type": "string"
                  },
                  "lastName": {
                    "type": "string"
                  },
                  "email": {
                    "type": "string"
                  },
                  "profileImage": {
                    "type": "string",
                    "nullable": true
                  }
                }
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Updated user"
          }
        }
      }
    },
    "/api/modules": {
      "get": {
        "summary": "List modules",
        "tags": [
          "Modules"
        ],
        "parameters": [
          {
            "name": "published",
            "in": "query",
            "schema": {
              "type": "boolean"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "List of modules"
          }
        }
      },
      "post": {
        "summary": "Create module (instructor/admin)",
        "tags": [
          "Modules"
        ],
        "security": [
